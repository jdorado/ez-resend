{
  "schemaVersion": 2,
  "services": {
    "resend": {
      "buildTarget": "runtime",
      "volumes": {
        "profile": "/state"
      },
      "command": ["node", "/app/src/cli.mjs", "serve"],
      "environment": {"EZ_RESEND_SERVICE": "1"},
      "healthcheck": [
        "node",
        "/app/src/cli.mjs",
        "health"
      ],
      "memoryMiB": 128
    }
  },
  "commands": {
    "resend": {
      "service": "resend",
      "argv": [
        "node",
        "/app/src/cli.mjs"
      ]
    }
  }
}
